# --- Datenbank ---------------------------------------------------------------
# Im All-in-One-Container wird diese Variable automatisch gesetzt.
# Für eine externe Datenbank hier die Verbindungszeichenfolge eintragen.
DATABASE_URL=postgres://saru:saru@localhost:5433/saru

# --- Sicherheit --------------------------------------------------------------
# Signiert die Session-Cookies. Mindestens 32 Zeichen.
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_SECRET=bitte-aendern-mindestens-32-zeichen-lang-000000

# Verschlüsselt hinterlegte API-Schlüssel in der Datenbank. Mindestens 32 Zeichen.
# Achtung: Wird dieser Schlüssel geändert, müssen die API-Schlüssel neu eingegeben werden.
NUXT_ENCRYPTION_KEY=bitte-aendern-mindestens-32-zeichen-lang-111111

# --- Dateien -----------------------------------------------------------------
NUXT_UPLOAD_DIR=./data/uploads
# Maximale Uploadgröße in Byte (Standard: 100 MB)
NUXT_MAX_UPLOAD_BYTES=104857600

# --- Erstes Administratorkonto ----------------------------------------------
# Wird nur angelegt, wenn noch kein Benutzer existiert.
NUXT_INITIAL_ADMIN_EMAIL=admin@saru.local
NUXT_INITIAL_ADMIN_PASSWORD=SaruAdmin!2025

# --- Betrieb -----------------------------------------------------------------
NUXT_LOG_LEVEL=info
# Auf "true" setzen, wenn die Anwendung hinter einem Reverse Proxy läuft.
NUXT_TRUST_PROXY=false
PORT=3000
# Dev: damit Collabora (WOPI) SARU über die LAN-IP erreichen kann:
# HOST=0.0.0.0
# npm run dev -- --host 0.0.0.0 --port 3001
# Selbstsignierte Collabora-Zertifikate für Discovery akzeptieren (Standard: LAN/localhost).
# NUXT_COLLABORA_INSECURE_TLS=true
